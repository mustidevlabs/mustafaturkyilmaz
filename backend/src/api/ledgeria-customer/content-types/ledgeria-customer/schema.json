{
  "kind": "collectionType",
  "collectionName": "ledgeria_customers",
  "info": {
    "singularName": "ledgeria-customer",
    "pluralName": "ledgeria-customers",
    "displayName": "Ledgeria Customer",
    "description": "Vendor customer records for Ledgeria commercial licensing (admin-web)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "customerKey": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 120
    },
    "displayName": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "notes": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "suspended"],
      "default": "active",
      "required": true
    },
    "downloadPasswordHash": {
      "type": "string",
      "maxLength": 255
    },
    "downloadPasswordLookup": {
      "type": "string",
      "unique": true,
      "maxLength": 64
    },
    "downloadPasswordSetAt": {
      "type": "datetime"
    },
    "occupiedClientIds": {
      "type": "json"
    },
    "licenses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::ledgeria-license.ledgeria-license",
      "mappedBy": "customer"
    }
  }
}
