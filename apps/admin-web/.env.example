# --- Admin gate (Strapi Users & Permissions) ---
# Create application users in Strapi Admin; admin-web is login-only.
# Local dev only: skip auth when NODE_ENV=development (never set in production).
# SKIP_ADMIN_AUTH=1

NEXT_PUBLIC_STRAPI_URL=https://timely-spirit-9e046731e1.strapiapp.com
# Strapi Cloud (same project as `backend/` workspace). Change URL for local Strapi.
# Public portfolio link in header; default matches portfolio-web dev port.
NEXT_PUBLIC_PORTFOLIO_URL=http://localhost:3000
# Strapi API token: find/create/update/delete on Ledgeria Issue, Customer, Edition, License (full access is simplest).
STRAPI_API_TOKEN=
# --- Ledgeria license signing (admin-web server only; never commit the private key) ---
# Prefer UI: /ledgeria/settings/license-keys (stores encrypted key in apps/admin-web/.data/).
# Or set env (overrides UI store):
# Dev key (PKCS8 DER base64, keyId "dev") — matches Ledgeria packages/shared licenseKeys.ts
# LEDGERIA_LICENSE_PRIVATE_KEY_PKCS8_B64=MC4CAQAwBQYDK2VwBCIEIOGRLuq+lKQJDytmiA9rz8Rsilv4Bw886jXC9Gh/Hoq4
# LEDGERIA_LICENSE_KEY_ID=dev
# Optional: passphrase for encrypting .data/license-signing.json (defaults to hash of STRAPI_API_TOKEN)
# LEDGERIA_LICENSE_KEY_STORE_SECRET=
# Public origin of this admin (used in the customer password card). Desktop must POST here:
# NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3002
# LEDGERIA_LICENSE_DOWNLOAD_PUBLIC_URL=http://localhost:3002/api/ledgeria/license
# Stable HMAC pepper for password lookup (do not rotate casually; existing hashes stay valid,
# but lookup keys would break). Falls back to KEY_STORE_SECRET then STRAPI_API_TOKEN.
# LEDGERIA_LICENSE_PASSWORD_PEPPER=
# Production: generate via UI or openssl, put public SPKI in Ledgeria licenseKeys.ts with a new keyId,
# keep private key only here (env or secrets store). Never NEXT_PUBLIC_*.
# Development only: if Node TLS to Strapi fails, reuse STRAPI_API_TOKEN for browser fetch (no duplicate line). Never set in production.
# STRAPI_DEV_MIRROR_API_TOKEN_TO_BROWSER=1
# Dev only: alternative to mirroring — duplicate token here for browser fetch (inlined in client JS).
# NEXT_PUBLIC_STRAPI_DEV_BROWSER_TOKEN=
# Optional: corporate outbound proxy (same semantics as curl / Git). NO_PROXY is respected.
# HTTPS_PROXY=http://127.0.0.1:8888
# NO_PROXY=localhost,127.0.0.1
# Optional: PEM file with extra CAs when a proxy does TLS inspection (see Node docs).
# NODE_EXTRA_CA_CERTS=/path/to/org-root.pem
