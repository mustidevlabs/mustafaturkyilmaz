{
  "name": "mustafaturkyilmaz",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: shared Strapi backend + portfolio (admin dashboard moved to mustidev/apps/dashboard)",
  "workspaces": [
    "apps/*",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n ledgeria-api,portfolio -c blue,magenta \"npm run dev -w ledgeria-api\" \"npm run dev -w portfolio-web\"",
    "dev:ledgeria-api": "npm run dev -w ledgeria-api",
    "dev:backend": "npm run dev -w ledgeria-api",
    "dev:portfolio": "npm run dev -w portfolio-web",
    "build": "npm run build -w ledgeria-api && npm run build -w portfolio-web",
    "start": "concurrently -n ledgeria-api,portfolio -c blue,magenta \"npm run start -w ledgeria-api\" \"npm run start -w portfolio-web\"",
    "start:ledgeria-api": "npm run start -w ledgeria-api",
    "start:portfolio": "npm run start -w portfolio-web",
    "check:strapi": "node scripts/check-strapi-cloud.mjs",
    "backup:strapi-code": "bash scripts/backup-backend-for-strapi-reset.sh",
    "backup:strapi-export": "bash scripts/strapi-export-to-backups.sh"
  },
  "dependencies": {
    "@strapi/strapi": "5.46.0",
    "js-yaml": "^4.1.1"
  },
  "overrides": {
    "@strapi/admin": "5.46.0",
    "@strapi/core": "5.46.0",
    "@strapi/data-transfer": "5.46.0",
    "@strapi/database": "5.46.0",
    "@strapi/logger": "5.46.0",
    "@strapi/permissions": "5.46.0",
    "@strapi/strapi": "5.46.0",
    "@strapi/types": "5.46.0",
    "@strapi/typescript-utils": "5.46.0",
    "@strapi/utils": "5.46.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
